# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# EDIT_PIN: Master PIN required for editing the map (required in production)
EDIT_PIN="CHANGE_ME"

# SESSION_SECRET: Secret used to sign master session tokens
SESSION_SECRET="CHANGE_ME_RANDOM_HEX"

# DATABASE_URL: Optional PostgreSQL connection string (e.g. ONREZA / Cloud SQL).
# When omitted, data is persisted atomically in ./data/
DATABASE_URL=""

# TILES_BASE_URL: Base URL for map tiles if hosted on S3 / Cloudflare R2 / CDN
TILES_BASE_URL="https://raw.githubusercontent.com/DathSidius/morion-map/relaxdev/onreza-output/tiles"
